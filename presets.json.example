      "emphasis": "Original",
      "sdxl_crop_top": 0,
      "sdxl_crop_left": 0
    }
  },
  "MyCustomBackend": {
    "runtime_force_noise_source": "CPU",
    "options": {
      "randn_source": "CPU",
      "emphasis": "Original"
    }
  }
